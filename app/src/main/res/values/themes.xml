<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Thème Material 3, clair uniquement, pour un rendu cohérent et professionnel. -->
    <style name="Base.Theme.AppVente" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorTextOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryLight</item>
        <item name="colorOnPrimaryContainer">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorSurfaceVariant">@color/colorPhotoBackground</item>
        <item name="colorOnSurfaceVariant">@color/colorTextSecondary</item>
        <item name="colorError">@color/colorError</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/colorBackground</item>

        <item name="materialButtonStyle">@style/Widget.AppVente.Button</item>
        <item name="materialCardViewStyle">@style/Widget.AppVente.Card</item>
        <item name="textInputStyle">@style/Widget.AppVente.TextInput</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AppVente.Dialog</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.AppVente.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AppVente.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.AppVente.Large</item>
    </style>

    <style name="Theme.AppVente" parent="Base.Theme.AppVente" />

    <!-- Boutons arrondis, hauteur confortable -->
    <style name="Widget.AppVente.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Cartes douces -->
    <style name="Widget.AppVente.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1.5dp</item>
        <item name="cardBackgroundColor">@color/colorCardBackground</item>
    </style>

    <!-- Champs de saisie encadrés et arrondis -->
    <style name="Widget.AppVente.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/colorTextSecondary</item>
        <item name="boxStrokeColor">@color/colorPrimaryLight</item>
        <item name="boxStrokeWidth">1.5dp</item>
    </style>

    <!-- Barre de recherche : champ arrondi sans soulignement interne -->
    <style name="ThemeOverlay.AppVente.SearchView" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorHint">@color/colorTextSecondary</item>
        <item name="searchViewStyle">@style/Widget.AppVente.SearchView</item>
    </style>

    <style name="Widget.AppVente.SearchView" parent="Widget.AppCompat.SearchView">
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="queryBackground">@android:color/transparent</item>
        <item name="submitBackground">@android:color/transparent</item>
        <item name="searchHintIcon">@drawable/ic_search</item>
        <item name="closeIcon">@drawable/ic_search_close</item>
    </style>

    <!-- Coins arrondis -->
    <style name="ShapeAppearance.AppVente.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.AppVente.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.AppVente.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Boîtes de dialogue arrondies -->
    <style name="ThemeOverlay.AppVente.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AppVente.Medium</item>
    </style>
</resources>
