<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarMain"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_gradient_toolbar"
            android:title="@string/app_name"
            android:subtitle="@string/sous_titre_liste"
            app:subtitleTextColor="@color/colorSubtitleOnPrimary"
            app:titleTextColor="@color/colorTextOnPrimary" />

        <!-- Bannière d'accueil : salutation + nombre de vendeurs -->
        <LinearLayout
            android:id="@+id/headerBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingVertical="20dp">

            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_logo_circle">

                <ImageView
                    android:id="@+id/imgHeaderAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/photo_vendeur"
                    android:padding="12dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person_placeholder"
                    app:tint="@color/white" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHeaderSalutation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/colorTextOnPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Bonjour, Jean !" />

                <TextView
                    android:id="@+id/txtHeaderCompte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/colorSubtitleOnPrimary"
                    android:textSize="13sp"
                    tools:text="3 vendeurs enregistrés" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnLogout"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_btn_logout"
                android:contentDescription="@string/se_deconnecter"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_logout"
                android:tint="@color/white"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Barre de recherche : champ arrondi bien visible sous la bannière -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_search_view"
                android:minHeight="50dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="6dp"
                app:iconifiedByDefault="false"
                app:queryBackground="@android:color/transparent"
                app:queryHint="@string/rechercher_hint"
                app:searchHintIcon="@drawable/ic_search"
                app:theme="@style/ThemeOverlay.AppVente.SearchView" />

            <!-- Filtre par date de naissance : deux bornes de dates cliquables + bouton effacer -->
            <LinearLayout
                android:id="@+id/layoutFiltreDates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtDateDebutFiltre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_champ_date"
                    android:clickable="true"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/ic_calendar"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:text="@string/date_debut_filtre"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="13sp"
                    app:drawableTint="@color/colorTextSecondary" />

                <TextView
                    android:id="@+id/txtDateFinFiltre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_champ_date"
                    android:clickable="true"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/ic_calendar"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:text="@string/date_fin_filtre"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="13sp"
                    app:drawableTint="@color/colorTextSecondary" />

                <ImageView
                    android:id="@+id/btnEffacerFiltre"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_icon_delete"
                    android:contentDescription="@string/effacer_filtre"
                    android:padding="10dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/colorDelete" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewVendeurs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="104dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_vendeur" />

    <LinearLayout
        android:id="@+id/etatVide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="24dp"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_photo_circle"
                android:contentDescription="@null"
                android:padding="28dp"
                android:src="@drawable/ic_person_placeholder"
                app:tint="@color/colorPrimary" />

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_badge_circle"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_add"
                app:tint="@color/white" />

        </FrameLayout>

        <TextView
            android:id="@+id/txtListeVide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/aucun_vendeur"
            android:textColor="@color/colorTextSecondary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAjouterVide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/colorPrimary"
            android:paddingHorizontal="24dp"
            android:text="@string/ajouter_premier_vendeur"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAjouter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/ajouter_vendeur"
        android:text="@string/ajouter_court"
        android:textColor="@color/colorTextOnPrimary"
        app:backgroundTint="@color/colorPrimary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/colorTextOnPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
