<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addEditRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    tools:context=".AddEditVendeurActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarAddEdit"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_gradient_toolbar"
            app:navigationIcon="@drawable/ic_close"
            app:titleTextColor="@color/colorTextOnPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Photo avec bouton caméra superposé -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:clipChildren="true"
                    android:clipToOutline="true"
                    app:cardBackgroundColor="@color/colorPhotoBackground"
                    app:cardCornerRadius="65dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imgPhotoEdit"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/photo_vendeur"
                        android:padding="30dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person_placeholder"
                        app:tint="@color/colorPrimary" />

                </androidx.cardview.widget.CardView>

                <ImageView
                    android:id="@+id/btnChoisirPhoto"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_camera_button"
                    android:contentDescription="@string/choisir_photo"
                    android:padding="9dp"
                    android:src="@drawable/ic_camera" />

            </FrameLayout>

            <TextView
                android:id="@+id/txtChoisirPhotoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp"
                android:text="@string/choisir_photo"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Carte des informations -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInfos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="24dp"
                app:cardElevation="1.5dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.04"
                        android:text="@string/informations_vendeur"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutNom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/nom_vendeur"
                        app:helperText="@string/exemple_nom"
                        app:startIconDrawable="@android:drawable/ic_menu_myplaces">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editNom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:textColor="@color/colorTextPrimary" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtDatenais"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_champ_date"
                        android:clickable="true"
                        android:drawablePadding="10dp"
                        android:drawableStart="@drawable/ic_calendar"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:hint="@string/date_naissance"
                        android:padding="16dp"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextSecondary"
                        android:textSize="15sp"
                        app:drawableTint="@color/colorTextSecondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnregistrer"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="@string/enregistrer"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />

            <ProgressBar
                android:id="@+id/progressBarEnregistrement"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/colorAccent"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
